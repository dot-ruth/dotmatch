# Copy to .env.local and adjust per environment.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Optional: shared secret sent as X-Discover-Token to POST /api/jobs/discover.
# Must match the backend's DOTMATCH_DISCOVER_TOKEN. Without a backend token,
# discovery only accepts requests from 127.0.0.1 / ::1.
# NEXT_PUBLIC_DISCOVER_TOKEN=change-me
